# =============================================================================
# BiboERM Backend — Environment Configuration
# Copy to .env and adjust for your environment.
# =============================================================================

APP_NAME="Bibo ERM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Frontend SPA (Next.js) — required for Sanctum cookie auth + CORS
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# Hosts that receive stateful session cookies (must include port if used in Origin)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8000,127.0.0.1,127.0.0.1:3000,127.0.0.1:8000

# Exact browser origin(s) allowed for credentialed cross-origin requests
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Default super admin (created by php artisan db:seed)
# -----------------------------------------------------------------------------
ADMIN_NAME="Bibo System Admin"
ADMIN_EMAIL=admin@bibo.com
ADMIN_PASSWORD="Admin@2026!!"
ADMIN_EMPLOYEE_NUMBER=SYS-0001
# Set true to re-run DefaultAdminSeeder on every boot (dev only)
ADMIN_SEED_ON_BOOT=false

# -----------------------------------------------------------------------------
# Auth tokens & session
# -----------------------------------------------------------------------------
REFRESH_TOKEN_COOKIE=refresh_token
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=15

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): set APP_DEBUG=false and SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# User onboarding
# -----------------------------------------------------------------------------
INVITE_EXPIRY_HOURS=72

# -----------------------------------------------------------------------------
# File storage (project root — outside backend/)
# Profiles, field-work, etc. Add categories in config/bibo.php as modules grow.
# Run once: php artisan storage:link  (public/media → ../storage/public)
# Public files (avatars) served at APP_URL/media/…
# Private files (field-work) served only via authenticated /api/v1/files/…
# -----------------------------------------------------------------------------
BIBO_STORAGE_PATH=../storage
BIBO_STORAGE_DISK=bibo
BIBO_STORAGE_URL=
BIBO_PROFILE_MAX_KB=2048
BIBO_PROFILE_MAX_WIDTH=4096
BIBO_PROFILE_MAX_HEIGHT=4096
BIBO_FIELD_WORK_MAX_KB=10240

# Default employee number format for HR auto-generate (prefix + zero-padded sequence)
BIBO_EMPLOYEE_NUMBER_PREFIX=EMP
BIBO_EMPLOYEE_NUMBER_PAD=4

# Default supplier code format for procurement auto-generate (prefix + zero-padded sequence)
BIBO_SUPPLIER_CODE_PREFIX=SUP
BIBO_SUPPLIER_CODE_PAD=3
BIBO_SUPPLIER_CATEGORY_CODE_PAD=2

# Default driver code format for procurement auto-generate (prefix + zero-padded sequence)
BIBO_DRIVER_CODE_PREFIX=DRV
BIBO_DRIVER_CODE_PAD=3

# Device lock — requires X-Device-Id header from frontend (off in dev)
DEVICE_LOCK_ENABLED=false
DEVICE_LOCK_ENFORCE_ROLES=super_admin,it_admin

# -----------------------------------------------------------------------------
# Rate limiting (requests per window)
# -----------------------------------------------------------------------------
INVITE_RATE_LIMIT_PER_HOUR=10
LOGIN_RATE_LIMIT_PER_MIN=5
REFRESH_RATE_LIMIT_PER_MIN=30
ACCEPT_INVITE_RATE_LIMIT_PER_MIN=10
FORGOT_PASSWORD_RATE_LIMIT_PER_MIN=5
RESET_PASSWORD_RATE_LIMIT_PER_MIN=10
RECOVER_EMAIL_RATE_LIMIT_PER_MIN=5
UPLOAD_RATE_LIMIT_PER_MIN=10
TWO_FACTOR_OTP_EXPIRE_MINUTES=10
TWO_FACTOR_VERIFY_RATE_LIMIT_PER_MIN=10
TWO_FACTOR_RESEND_RATE_LIMIT_PER_MIN=3

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Create DB first: CREATE DATABASE bibo_erm;
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bibo_erm
DB_USERNAME=postgres
DB_PASSWORD="Adm78647864!"

# SQLite (alternative for quick local dev — no server required)
# DB_CONNECTION=sqlite

# Tests use .env.testing + phpunit.xml (SQLite :memory: by default).
# Optional separate PostgreSQL test DB instead of SQLite:
#   CREATE DATABASE bibo_erm_test;
# Then set DB_CONNECTION=pgsql and DB_DATABASE=bibo_erm_test in .env.testing

# MySQL / MariaDB (alternative — e.g. XAMPP)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bibo_erm
# DB_USERNAME=root
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# Mail
# Invite + password-reset emails use FRONTEND_URL for links.
#
# Gmail SMTP (recommended for dev/small deployments):
# 1. Enable 2FA on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Fill in MAIL_USERNAME + MAIL_PASSWORD below
# 4. Set MAIL_FROM_ADDRESS to the same Gmail address
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Queue (database queue processes invite/reset emails when worker is running)
# Run: php artisan queue:work
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Cache & storage
# -----------------------------------------------------------------------------
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Optional: AWS S3 / Redis (production)
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Laravel defaults
# -----------------------------------------------------------------------------
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Quotation / FX (USD → KES fallback when live rate API is unavailable)
# -----------------------------------------------------------------------------
BIBO_USD_TO_KES_RATE=129.0
BIBO_EXCHANGE_RATE_CACHE_MINUTES=60
