# =============================================================================
# BiboERM Frontend — Environment Configuration
# Copy to .env.local for local development.
# =============================================================================

# Laravel API origin — NO /api suffix (client adds /api and /sanctum paths)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production example:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# -----------------------------------------------------------------------------
# Local dev checklist (must match backend .env)
# -----------------------------------------------------------------------------
# Backend APP_URL=http://localhost:8000
# Backend FRONTEND_URL=http://localhost:3000
# Backend CORS_ALLOWED_ORIGINS=http://localhost:3000
# Backend SANCTUM_STATEFUL_DOMAINS includes localhost:3000
#
# Start backend:  cd backend && php artisan serve        (port 8000)
# Start frontend: cd frontend && npm run dev             (port 3000)
# Seed admin:     cd backend && php artisan migrate --seed
#
# Default admin login: admin@bibo.com / Admin@2026!!
